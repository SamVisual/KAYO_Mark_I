{
  "name": "kayo-mark-i",
  "version": "1.0.0",
  "private": true,
  "description": "KAYO Mark I – Personal AI Assistant Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "dev":       "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:win": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react":        "^18.3.1",
    "react-dom":    "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer":         "^10.4.20",
    "concurrently":         "^9.1.2",
    "electron":             "^33.3.1",
    "electron-builder":     "^25.1.8",
    "postcss":              "^8.5.1",
    "tailwindcss":          "^3.4.17",
    "vite":                 "^6.0.7",
    "wait-on":              "^8.0.1"
  },
  "build": {
    "appId":       "com.kayo.marki",
    "productName": "KAYO Mark I",
    "asar":        true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "KAYO-Mark-I.exe"
    }
  }
}
