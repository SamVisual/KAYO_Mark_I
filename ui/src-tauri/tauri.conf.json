{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KAYO",
  "version": "1.0.0",
  "identifier": "com.kayo.app",
  "build": {
    "frontendDist":      "../build",
    "devUrl":            "http://localhost:5173",
    "beforeDevCommand":  "npm run dev:vite",
    "beforeBuildCommand":"npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label":       "main",
        "title":       "KAYO Mark I",
        "width":       1280,
        "height":      820,
        "minWidth":    900,
        "minHeight":   600,
        "decorations": false,
        "transparent": true,
        "center":      true,
        "resizable":   true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active":  true,
    "targets": "nsis",
    "externalBin": [
      "sidecar/memory_server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon":           "icons/icon.ico",
        "languages":               ["German"],
        "displayLanguageSelector": false
      }
    }
  }
}
